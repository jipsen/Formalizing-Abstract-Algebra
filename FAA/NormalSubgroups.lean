import Mathlib.GroupTheory.Coset.Basic
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Normal Subgroups and Factor Groups

Judson, *Abstract Algebra: Theory and Applications*, Chapter 10:
normal subgroups, factor groups, and the simplicity of `Aₙ`.

## Statements

- Judson 10.1.3 (normal subgroup criteria): `normal_iff_conj_mem`,
  `normal_iff_leftCoset_eq_rightCoset`
- Judson 10.1.4 (factor groups): `quotient_group`
- Judson 10.2.1 (`Aₙ` generated by 3-cycles): `alternatingGroup_closure_isThreeCycles`
- Judson 10.2.4 (`A₅` is simple): `alternatingGroup_five_simple`
-/

open scoped Pointwise

namespace AATA

variable {G : Type*} [Group G]

/-- **Judson 10.1.3 (a).** `N` is normal iff `g * n * g⁻¹ ∈ N` for all `n ∈ N`, `g ∈ G`. -/
theorem normal_iff_conj_mem (N : Subgroup G) :
    N.Normal ↔ ∀ n ∈ N, ∀ g : G, g * n * g⁻¹ ∈ N :=
  ⟨fun h n hn g ↦ by simpa using h.conj_mem' n hn g⁻¹,
    fun h ↦ ⟨fun n hn g ↦ h n hn g⟩⟩

/-- **Judson 10.1.3 (b).** `N` is normal iff every left coset equals the right coset. -/
theorem normal_iff_leftCoset_eq_rightCoset (N : Subgroup G) :
    N.Normal ↔ ∀ g : G, g • (N : Set G) = MulOpposite.op g • (N : Set G) :=
  normal_iff_eq_cosets N

/-- **Judson 10.1.4.** If `N` is normal, then `G ⧸ N` is a group. -/
abbrev quotient_group (N : Subgroup G) [N.Normal] : Group (G ⧸ N) := inferInstance

/-- **Judson 10.2.1.** `Aₙ` is generated by the 3-cycles. -/
theorem alternatingGroup_closure_isThreeCycles {α : Type*} [DecidableEq α] [Fintype α] :
    Subgroup.closure
      {g : alternatingGroup α | Equiv.Perm.IsThreeCycle (g : Equiv.Perm α)} = ⊤ :=
  alternatingGroup.closure_isThreeCycles_eq_top

/-- **Judson 10.2.4.** `A₅` is a simple group. -/
theorem alternatingGroup_five_simple : IsSimpleGroup (alternatingGroup (Fin 5)) :=
  inferInstance

end AATA
